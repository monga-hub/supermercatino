{
  "name": "supermercatino",
  "description": "Il Supermercatino — gestionale isometrico in un supermercato italiano anni 80-90",
  "version": "0.0.1",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  },
  "private": true
}
